# ─────────────────────────────────────────────────────────────────────────────
# Shipyard environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
LOG_LEVEL=info

# --- Database (Postgres) ---
# Matches infra/docker/docker-compose.yml defaults
DATABASE_URL=postgresql://shipyard:shipyard@localhost:5432/shipyard?schema=public

# --- Redis (queues / pub-sub) ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000

# --- Web dashboard ---
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Auth (Auth.js) ---
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-byte-random-secret
AUTH_URL=http://localhost:3000

# --- GitHub OAuth (login) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- GitHub App (PR webhooks + repo access) ---
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Secret encryption (env vars at rest) ---
# 32-byte key, base64. Generate: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=replace-me-with-32-byte-base64-key

# --- Deploy engine ---
# Docker daemon socket the worker uses to spin up preview stacks
DOCKER_HOST=unix:///var/run/docker.sock
# Wildcard DNS domain for preview URLs, e.g. *.preview.shipyard.local
PREVIEW_BASE_DOMAIN=preview.shipyard.local
# Default auto-stop idle timeout for previews (minutes)
PREVIEW_AUTO_STOP_MINUTES=120
# TTL after which a closed-PR preview is destroyed (minutes)
PREVIEW_DESTROY_TTL_MINUTES=60

# --- Cost model (USD) ---
COST_PER_VCPU_HOUR=0.04
COST_PER_GB_MEM_HOUR=0.005
COST_PER_GB_STORAGE_HOUR=0.0002
COST_PER_GB_EGRESS=0.09
