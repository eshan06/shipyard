{
  "name": "@shipyard/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shipyard background workers: deploy, destroy/cleanup, cost roll-ups, log relay (BullMQ).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@shipyard/core": "workspace:*",
    "@shipyard/db": "workspace:*",
    "@shipyard/deploy-engine": "workspace:*",
    "bullmq": "^5.34.10",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "prom-client": "^15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@shipyard/config": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
