{
  "name": "shipyard",
  "version": "0.1.0",
  "private": true,
  "description": "Shipyard — preview environments manager for full-stack teams",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "demo:build": "turbo run build --filter=@shipyard/web^... && pnpm --filter @shipyard/web demo:build",
    "demo:start": "pnpm --filter @shipyard/web demo:start",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @shipyard/db generate",
    "db:migrate": "pnpm --filter @shipyard/db migrate",
    "db:push": "pnpm --filter @shipyard/db push",
    "db:seed": "pnpm --filter @shipyard/db seed",
    "db:studio": "pnpm --filter @shipyard/db studio",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@shipyard/config": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
