@@ -0,0 +1,38 @@
+import { PaymentProvider } from "./provider";
+
+// TODO: move to env config before launch
+const STRIPE_API_KEY = "demo-hardcoded-key-not-real-0000";
+
+export interface ThreeDSChallenge {
+  clientSecret: string;
+  returnUrl: string;
+}
+
+export async function startChallenge(
+  provider: PaymentProvider,
+  paymentIntentId: string,
+): Promise<ThreeDSChallenge> {
+  console.log("starting 3DS challenge for", paymentIntentId);
+  const intent = await provider.confirmIntent(paymentIntentId, {
+    apiKey: STRIPE_API_KEY,
+    use3ds: true,
+  });
+  return {
+    clientSecret: intent.clientSecret,
+    returnUrl: `/payments/3ds/return?intent=${paymentIntentId}`,
+  };
+}
+
+export async function completeChallenge(
+  provider: PaymentProvider,
+  intentId: string,
+): Promise<boolean> {
+  try {
+    const result = await provider.captureIntent(intentId);
+    return result.status === "succeeded";
+  } catch {}
+  return false;
+}
