{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      // ^build covers each package's declared deps; the explicit config#build
      // is needed because every eslint.config.mjs (root included) imports the
      // shared flat config from @shipyard/config's built dist/, and no package
      // declares a runtime dependency on it.
      "dependsOn": ["^build", "@shipyard/config#build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      // Infra/config env the real-DB integration suites read. Turbo's strict
      // env mode strips undeclared vars, which silently skipped those suites
      // (locally AND in CI) even with Postgres provisioned. Declared in `env`
      // (not passThroughEnv) so runs with/without a DB cache separately.
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "SESSION_SECRET",
        "SECRETS_ENCRYPTION_KEY",
        "PUBLIC_APP_URL",
        "PUBLIC_API_URL",
        "PREVIEW_BASE_DOMAIN"
      ]
    },
    "db:generate": {
      "cache": false
    }
  }
}
