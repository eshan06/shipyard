# The workspace is mounted on a filesystem (virtiofs bind mount over OneDrive)
# that does not permit symlinks, which breaks pnpm's default symlinked
# node_modules layout (ERR_PNPM_EPERM creating symlinks). The hoisted linker
# produces a flat, copy-based node_modules with no symlinks, which works on such
# filesystems.
node-linker=hoisted
# `shamefully-hoist` flattens ALL transitive deps to the root node_modules,
# avoiding the per-package nested `node_modules` dirs whose atomic rename pnpm
# performs during linking — that rename intermittently fails with EACCES on this
# mount (OneDrive sync locks). Hoisting fully sidesteps it.
shamefully-hoist=true
auto-install-peers=true
strict-peer-dependencies=false
