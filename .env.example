# ─────────────────────────────────────────────────────────────────────────────
# Shipyard environment configuration.
# Copy to `.env` and fill in. NEVER commit `.env`. See docs/ENGINEERING.md §4.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core (shared by api + worker) ---
NODE_ENV=development
LOG_LEVEL=info

# --- Database (Postgres) — matches infra/docker/docker-compose.yml ---
DATABASE_URL=postgresql://shipyard:shipyard@localhost:5432/shipyard?schema=public

# --- Redis (BullMQ queues + pub/sub) ---
REDIS_URL=redis://localhost:6379

# --- Secret encryption (env vars at rest, AES-256-GCM) ---
# 32-byte key, base64. Generate: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=replace-me-with-32-byte-base64-key

# --- API (apps/api) ---
API_HOST=0.0.0.0
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
PUBLIC_APP_URL=http://localhost:3000
# Wildcard DNS domain for preview URLs, e.g. <slug>.preview.localhost
PREVIEW_BASE_DOMAIN=preview.localhost
# >= 32 chars; signs the session JWT cookie. Generate: openssl rand -hex 32
SESSION_SECRET=replace-me-with-32-byte-random-secret
# Dev convenience: allow password-less POST /api/v1/auth/dev-login for a seeded user.
DEV_AUTH=true
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute

# --- Product analytics / telemetry (apps/api) ---
# Sink for events posted to POST /api/v1/telemetry (and server-side app.analytics).
#   log     = structured pino events to the API log (default; nothing leaves the cluster)
#   http    = POST each event as JSON to ANALYTICS_HTTP_ENDPOINT
#   posthog = send events to PostHog's capture API
ANALYTICS_DRIVER=log
# Required when ANALYTICS_DRIVER=http:
ANALYTICS_HTTP_ENDPOINT=
# Optional Authorization header for the http collector, e.g. "Bearer <token>":
ANALYTICS_HTTP_AUTH_HEADER=
# Required when ANALYTICS_DRIVER=posthog:
ANALYTICS_POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_POSTHOG_API_KEY=

# --- GitHub OAuth (dashboard login) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- GitHub App (PR webhooks + repo access) ---
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Worker (apps/worker) ---
# mock = in-memory orchestrator (no Docker needed); docker = real preview stacks
DEPLOY_DRIVER=mock
DOCKER_HOST=
WORKER_CONCURRENCY=4
CLEANUP_INTERVAL_MS=60000
COST_INTERVAL_MS=300000
# Default auto-stop idle timeout / closed-PR destroy TTL (minutes)
PREVIEW_AUTO_STOP_MINUTES=120
PREVIEW_DESTROY_TTL_MINUTES=60

# --- Cost model (USD) ---
COST_PER_VCPU_HOUR=0.04
COST_PER_GB_MEM_HOUR=0.005
COST_PER_GB_STORAGE_HOUR=0.0002
COST_PER_GB_EGRESS=0.09

# --- Web dashboard (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Client product analytics (the trackEvent seam). Events post to the API's
# /api/v1/telemetry route; the API forwards them to ANALYTICS_DRIVER above.
# Set to "false" to disable client tracking entirely. "true" logs events to the
# browser console for debugging.
NEXT_PUBLIC_ANALYTICS_ENABLED=true
NEXT_PUBLIC_ANALYTICS_DEBUG=false
