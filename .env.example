# ─────────────────────────────────────────────────────────────────────────────
# Shipyard environment configuration.
# Copy to `.env` and fill in. NEVER commit `.env`. See docs/ENGINEERING.md §4.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core (shared by api + worker) ---
NODE_ENV=development
LOG_LEVEL=info
# Optional: Prisma client log levels as a comma-separated list of
#   query, info, warn, error
# Unset defaults to a quiet set: `warn,error` in production, `info,warn,error`
# otherwise. Set `PRISMA_LOG=query` to log every SQL statement when debugging.
PRISMA_LOG=

# --- Database (Postgres) — matches infra/docker/docker-compose.yml ---
# 127.0.0.1 (not `localhost`) on purpose: on Windows, `localhost` resolves to
# IPv6 ::1 first and Prisma's engine does not fall back to IPv4, so it cannot
# reach the Docker-published port. 127.0.0.1 works on every OS.
DATABASE_URL=postgresql://shipyard:shipyard@127.0.0.1:5432/shipyard?schema=public

# --- Redis (BullMQ queues + pub/sub) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Secret encryption (env vars at rest, AES-256-GCM) ---
# 32-byte key, base64. Generate: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=replace-me-with-32-byte-base64-key

# --- API (apps/api) ---
API_HOST=0.0.0.0
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
PUBLIC_APP_URL=http://localhost:3000
# Wildcard DNS domain for preview URLs, e.g. <slug>.preview.localhost
PREVIEW_BASE_DOMAIN=preview.localhost
# >= 32 chars; signs the session JWT cookie. Generate: openssl rand -hex 32
SESSION_SECRET=replace-me-with-32-byte-random-secret
# Dev convenience: allow password-less POST /api/v1/auth/dev-login for a seeded user.
# Keep this false in any deployed environment.
DEV_AUTH=true
# How much to trust X-Forwarded-* headers (client IP, proto) — passed to Fastify's
# `trustProxy`. Accepts a boolean (`true`/`false`/`yes`/`no`/`on`/`off`), a bare
# integer = number of proxy hops to trust (e.g. `1`), or a comma-separated
# IP/CIDR allowlist (e.g. `10.0.0.0/8,127.0.0.1`). Defaults to `true` for
# out-of-the-box local/dev. In production behind a single known proxy, set the
# hop count (`1`) or the proxy's subnet so clients cannot spoof X-Forwarded-For to
# defeat the per-IP rate limiter. Do NOT leave `true` if the API is directly
# reachable by clients.
TRUST_PROXY=true
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW="1 minute"

# --- Product analytics / telemetry (apps/api) ---
# Sink for events posted to POST /api/v1/telemetry (and server-side app.analytics).
#   log     = structured pino events to the API log (default; nothing leaves the cluster)
#   http    = POST each event as JSON to ANALYTICS_HTTP_ENDPOINT
#   posthog = send events to PostHog's capture API
ANALYTICS_DRIVER=log
# Required when ANALYTICS_DRIVER=http:
ANALYTICS_HTTP_ENDPOINT=
# Optional Authorization header for the http collector, e.g. "Bearer <token>":
ANALYTICS_HTTP_AUTH_HEADER=
# Required when ANALYTICS_DRIVER=posthog:
ANALYTICS_POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_POSTHOG_API_KEY=

# --- GitHub OAuth (dashboard login) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- GitHub App (PR webhooks + repo access) ---
# The worker reads GITHUB_APP_ID + GITHUB_APP_PRIVATE_KEY at startup: when both
# are set it authenticates as the App (installation tokens) to clone private
# repos for docker builds and to post commit statuses (preview URL) back onto
# PRs. Leave blank to run without the App: public-repo clones and no PR
# statuses. CLIENT_ID/CLIENT_SECRET are not read by the current build (they are
# only needed for user-to-server OAuth, which Shipyard does via the separate
# GITHUB_OAUTH_* app above); kept here so the App's full credential set lives
# in one place.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM private key; literal `\n` escapes are accepted and normalized.
GITHUB_APP_PRIVATE_KEY=
# Shared secret used to verify inbound GitHub webhook HMAC-SHA256 signatures.
# MUST match the "Webhook secret" configured in your GitHub App. Leave BLANK
# here: webhook verification hard-fails (401) when it is unset, so no default is
# safe to ship — a committed default would let anyone forge webhook deliveries.
# (The local `scripts/e2e-webhook.mjs` demo passes its own value via env, so an
# empty default here does not break it.)
GITHUB_WEBHOOK_SECRET=

# --- Worker (apps/worker) ---
# mock = in-memory orchestrator (no Docker needed); docker = real preview stacks
DEPLOY_DRIVER=mock
DOCKER_HOST=
WORKER_CONCURRENCY=4
CLEANUP_INTERVAL_MS=60000
COST_INTERVAL_MS=300000
# Default auto-stop idle timeout / closed-PR destroy TTL (minutes)
PREVIEW_AUTO_STOP_MINUTES=120
PREVIEW_DESTROY_TTL_MINUTES=60
# Shared edge Docker network joining the preview reverse proxy (Traefik, see
# infra/docker/preview-proxy.yml) to each preview's ingress service. REQUIRED
# for routable <slug>.<PREVIEW_BASE_DOMAIN> URLs with DEPLOY_DRIVER=docker
# (`docker network create shipyard-edge`). Empty disables proxy wiring:
# previews are then reachable only via loopback host ports.
PREVIEW_EDGE_NETWORK=
# Scratch directory for per-deploy PR checkouts (docker driver). Defaults to
# a `shipyard-checkouts` dir under the OS temp dir when unset.
WORKSPACE_DIR=
# Optional private-registry credentials for base-image pulls/builds.
REGISTRY_SERVER=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
# Retention (days) for durable deployment log rows / cost records; 0 disables
# pruning. Reconcile previews stuck BUILDING/DEPLOYING after this many minutes.
LOG_RETENTION_DAYS=14
COST_RETENTION_DAYS=90
STUCK_DEPLOY_MINUTES=30

# --- Observability (apps/api + apps/worker) ---
# Prometheus /metrics: served by the API on its main port and by the worker on
# a dedicated metrics server (also serves the worker's /healthz liveness probe).
METRICS_ENABLED=true
METRICS_PORT=9090

# --- Cost model (USD) ---
COST_PER_VCPU_HOUR=0.04
COST_PER_GB_MEM_HOUR=0.005
COST_PER_GB_STORAGE_HOUR=0.0002
COST_PER_GB_EGRESS=0.09

# --- Web dashboard (apps/web) ---
# IMPORTANT: NEXT_PUBLIC_* are read by the browser bundle and are INLINED AT
# BUILD TIME by `next build` — they are baked into the image and cannot be
# changed at container runtime. For the prebuilt web image, set them as Docker
# build-args (see .github/workflows/release.yml + apps/web/Dockerfile), NOT as
# runtime env. They are listed here so `pnpm dev` (which reads .env) and the
# build-args stay in sync.
#
# The browser talks to the API same-origin through a catch-all Route Handler
# (apps/web/src/app/api/v1/[...path]/route.ts) that proxies to the API server.
# It resolves its upstream AT RUNTIME as API_URL ?? NEXT_PUBLIC_API_URL ??
# http://localhost:4000 — so in Compose/k8s set API_URL (runtime env, e.g. the
# in-cluster service URL) on the web container; NEXT_PUBLIC_API_URL remains the
# build-time/browser-visible value.
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Mirror of the worker's DEPLOY_DRIVER for the dashboard. With "mock" (local dev)
# preview URLs are fabricated and not reachable, so the dashboard's "Open" button
# routes to an in-app simulated preview instead of a dead external link. Set to
# "docker" in any real deployment so "Open" links straight to the live preview.
NEXT_PUBLIC_DEPLOY_DRIVER=mock
# Gates the dashboard's dev-login form (email-only, no password). Mirror of the
# API's DEV_AUTH. Set to "false" (or leave unset) in any deployed environment so
# the password-less login path is not offered in the UI.
NEXT_PUBLIC_DEV_AUTH=true
# Client product analytics (the trackEvent seam). Events post to the API's
# /api/v1/telemetry route; the API forwards them to ANALYTICS_DRIVER above.
# Set to "false" to disable client tracking entirely. "true" logs events to the
# browser console for debugging.
NEXT_PUBLIC_ANALYTICS_ENABLED=true
NEXT_PUBLIC_ANALYTICS_DEBUG=false
