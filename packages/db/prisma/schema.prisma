// Shipyard domain model.
// Preview environments manager: every PR gets a live, disposable full-stack env.
//
// Conventions:
//  - cuid() ids, createdAt/updatedAt on mutable rows
//  - soft references via enums for status machines
//  - secrets are stored encrypted (see EnvVar.valueEncrypted)

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & tenancy
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  avatarUrl   String?
  githubId    String?  @unique
  githubLogin String?  @unique
  isAdmin     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships  Membership[]
  reviews      Review[]
  auditLogs    AuditLog[]    @relation("AuditActor")
  notifications Notification[]
  apiTokens    ApiToken[]
  deployments  Deployment[]  @relation("DeploymentCreator")

  @@index([githubLogin])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     Membership[]
  projects    Project[]
  apiTokens   ApiToken[]
  auditLogs   AuditLog[]
  budgetUsdMonthly Decimal? @db.Decimal(12, 2)

  @@index([slug])
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  teamId    String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Projects (a connected repo) & PRs
// ─────────────────────────────────────────────────────────────────────────────

enum RepoProvider {
  GITHUB
  GITLAB
  BITBUCKET
}

model Project {
  id               String       @id @default(cuid())
  teamId           String
  name             String
  slug             String
  provider         RepoProvider @default(GITHUB)
  repoFullName     String // e.g. "acme/storefront"
  repoId           String?
  installationId   String? // GitHub App installation id
  defaultBranch    String       @default("main")
  framework        String? // next, vite, node, etc. (auto-detected)
  rootDirectory    String       @default(".")
  // Build/deploy configuration (compose file path, build cmd, etc.)
  config           Json         @default("{}")
  autoDeployPrs    Boolean      @default(true)
  autoStopMinutes  Int          @default(120)
  destroyTtlMinutes Int         @default(60)
  isArchived       Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  pullRequests PullRequest[]
  previews     Preview[]
  envVars      EnvVar[]
  seedTemplates SeedTemplate[]

  @@unique([teamId, slug])
  @@unique([provider, repoFullName])
  @@index([teamId])
}

enum PullRequestState {
  OPEN
  CLOSED
  MERGED
  DRAFT
}

model PullRequest {
  id          String           @id @default(cuid())
  projectId   String
  number      Int
  title       String
  authorLogin String
  authorAvatar String?
  headRef     String
  baseRef     String
  headSha     String
  state       PullRequestState @default(OPEN)
  url         String
  labels      String[]         @default([])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  // Set once on the OPEN→CLOSED/MERGED transition. The closed-PR destroy TTL
  // anchors on this (not `updatedAt`, which any later row mutation would bump),
  // so a long-closed preview is torn down on schedule. See
  // apps/worker/src/schedulers/cleanup.ts.
  closedAt    DateTime?

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  previews Preview[]

  @@unique([projectId, number])
  @@index([projectId, state])
}

// ─────────────────────────────────────────────────────────────────────────────
// Previews (the live environment) & deployments
// ─────────────────────────────────────────────────────────────────────────────

enum PreviewStatus {
  QUEUED
  BUILDING
  DEPLOYING
  RUNNING
  DEGRADED
  STOPPED
  FAILED
  DESTROYING
  DESTROYED
}

model Preview {
  id            String        @id @default(cuid())
  projectId     String
  pullRequestId String?
  name          String
  slug          String        @unique // used in URL: <slug>.preview.domain
  status        PreviewStatus @default(QUEUED)
  url           String?
  commitSha     String?
  branch        String?
  isPinned      Boolean       @default(false) // pinned previews skip auto-stop/destroy
  autoStopMinutes Int         @default(120)
  lastActivityAt DateTime     @default(now())
  expiresAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  destroyedAt   DateTime?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pullRequest PullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
  deployments Deployment[]
  services    Service[]
  envVars     EnvVar[]
  reviews     Review[]
  costRecords CostRecord[]

  @@index([projectId, status])
  @@index([status])
}

enum DeploymentTrigger {
  PR_OPENED
  PR_SYNC
  MANUAL
  REDEPLOY
  ROLLBACK
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  DEPLOYING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Deployment {
  id          String            @id @default(cuid())
  previewId   String
  commitSha   String
  trigger     DeploymentTrigger @default(PR_SYNC)
  status      DeploymentStatus  @default(QUEUED)
  createdById String?
  queuedAt    DateTime          @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  durationMs  Int?
  errorSummary String?

  preview   Preview  @relation(fields: [previewId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("DeploymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  build     Build?
  logs      LogChunk[]

  @@index([previewId, status])
  @@index([status])
}

enum BuildStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Build {
  id           String      @id @default(cuid())
  deploymentId String      @unique
  status       BuildStatus @default(PENDING)
  imageTag     String?
  cacheHit     Boolean     @default(false)
  exitCode     Int?
  errorSummary String? // parsed reason for failed builds (dashboard surface)
  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// Services inside a preview (web, api, db, cache, worker…)
// ─────────────────────────────────────────────────────────────────────────────

enum ServiceType {
  WEB
  API
  WORKER
  DATABASE
  CACHE
  CUSTOM
}

enum ServiceStatus {
  PENDING
  STARTING
  HEALTHY
  UNHEALTHY
  STOPPED
  CRASHED
}

model Service {
  id           String        @id @default(cuid())
  previewId    String
  name         String
  type         ServiceType   @default(CUSTOM)
  image        String?
  command      String?
  internalHost String?
  ports        Int[]         @default([])
  status       ServiceStatus @default(PENDING)
  containerId  String?
  healthPath   String?
  restartCount Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  preview Preview    @relation(fields: [previewId], references: [id], onDelete: Cascade)
  logs    LogChunk[]

  @@unique([previewId, name])
  @@index([previewId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Logs (recent chunks in DB; full logs streamed/archived externally)
// ─────────────────────────────────────────────────────────────────────────────

enum LogSource {
  BUILD
  DEPLOY
  RUNTIME
  SYSTEM
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

model LogChunk {
  id           String    @id @default(cuid())
  deploymentId String?
  serviceId    String?
  source       LogSource @default(SYSTEM)
  level        LogLevel  @default(INFO)
  seq          Int
  message      String
  timestamp    DateTime  @default(now())

  deployment Deployment? @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  service    Service?    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  // A deployment's log lines carry a monotonic, gap-free seq. The unique
  // constraint turns any seq-allocation regression into a loud failure instead
  // of a silent duplicate (see apps/worker/src/events.ts nextSeq).
  @@unique([deploymentId, seq])
  @@index([serviceId, seq])
}

// ─────────────────────────────────────────────────────────────────────────────
// Env vars & secrets (encrypted at rest)
// ─────────────────────────────────────────────────────────────────────────────

enum EnvScope {
  PROJECT
  PREVIEW
}

enum EnvTarget {
  BUILD
  RUNTIME
  BOTH
}

model EnvVar {
  id             String    @id @default(cuid())
  projectId      String?
  previewId      String?
  scope          EnvScope  @default(PROJECT)
  target         EnvTarget @default(BOTH)
  key            String
  valueEncrypted String // AES-256-GCM ciphertext (iv:tag:data)
  isSecret       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  preview Preview? @relation(fields: [previewId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@unique([previewId, key])
  @@index([projectId])
  @@index([previewId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Test data seeding
// ─────────────────────────────────────────────────────────────────────────────

enum SeedKind {
  SQL
  SCRIPT
  SNAPSHOT
}

model SeedTemplate {
  id        String   @id @default(cuid())
  projectId String
  name      String
  kind      SeedKind @default(SQL)
  source    String // inline SQL / script path / snapshot ref
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reviewers (surface PR review state on the dashboard)
// ─────────────────────────────────────────────────────────────────────────────

enum ReviewState {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  COMMENTED
  DISMISSED
}

model Review {
  id        String      @id @default(cuid())
  previewId String
  userId    String?
  login     String
  avatarUrl String?
  state     ReviewState @default(PENDING)
  updatedAt DateTime    @updatedAt
  createdAt DateTime    @default(now())

  preview Preview @relation(fields: [previewId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([previewId, login])
  @@index([previewId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cost tracking
// ─────────────────────────────────────────────────────────────────────────────

model CostRecord {
  id             String   @id @default(cuid())
  previewId      String
  periodStart    DateTime
  periodEnd      DateTime
  cpuSeconds     Float    @default(0)
  memoryGbHours  Float    @default(0)
  storageGbHours Float    @default(0)
  egressGb       Float    @default(0)
  estimatedUsd   Decimal  @db.Decimal(12, 4)
  computedAt     DateTime @default(now())

  preview Preview @relation(fields: [previewId], references: [id], onDelete: Cascade)

  @@index([previewId, periodStart])
}

// ─────────────────────────────────────────────────────────────────────────────
// Webhooks (idempotent processing), audit, tokens, notifications
// ─────────────────────────────────────────────────────────────────────────────

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  SKIPPED
}

model WebhookEvent {
  id         String        @id @default(cuid())
  provider   RepoProvider  @default(GITHUB)
  deliveryId String        @unique
  eventType  String
  action     String?
  payload    Json
  status     WebhookStatus @default(RECEIVED)
  error      String?
  receivedAt DateTime      @default(now())
  processedAt DateTime?

  @@index([eventType, action])
}

model AuditLog {
  id         String   @id @default(cuid())
  teamId     String?
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  team  Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
}

model ApiToken {
  id          String    @id @default(cuid())
  teamId      String
  userId      String?
  name        String
  hashedToken String    @unique
  prefix      String // first chars, shown in UI
  scopes      String[]  @default([])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId])
}

enum NotificationType {
  PREVIEW_READY
  BUILD_FAILED
  PREVIEW_STOPPED
  BUDGET_EXCEEDED
  REVIEW_REQUESTED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  metadata  Json             @default("{}")
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
